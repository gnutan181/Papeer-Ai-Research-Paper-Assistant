# Copy this file to .env for local development. Never commit real values.
GROQ_API_KEY=
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=
TAVILY_API_KEY=
GROQ_MODEL=
# Optional. When set, all LLM calls use Portkey's Groq gateway for routing,
# observability, retries/fallbacks configured in Portkey, and cost controls.
PORTKEY_API_KEY=
# Use a saved Portkey Model Catalog provider. Many production gateways block
# inline providers such as "groq"; for example: @production-groq.
PORTKEY_PROVIDER=
PORTKEY_CONFIG=
