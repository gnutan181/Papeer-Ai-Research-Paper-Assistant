# Copy this file to .env for local development. Never commit real values.
GROQ_API_KEY=
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=
TAVILY_API_KEY=
GROQ_MODEL=
# Optional. When set, all LLM calls use Portkey's Groq gateway for routing,
# observability, retries/fallbacks configured in Portkey, and cost controls.
PORTKEY_API_KEY=
# Use a saved Portkey Model Catalog provider. Many production gateways block
# inline providers such as "groq"; for example: @production-groq.
PORTKEY_PROVIDER=
PORTKEY_CONFIG=

# Multimodal storage. Local is the no-credential default; R2 is optional.
ASSET_STORE=local
LOCAL_ASSET_DIR=./data/assets
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Feature flags and hard per-request limits for free CPU hosting.
ENABLE_OCR=true
ENABLE_VISION=true
ENABLE_IMAGE_EMBEDDINGS=true
ENABLE_AUDIO_INPUT=true
ENABLE_BROWSER_TTS=true
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=40
MAX_FIGURES_PER_DOCUMENT=30
MAX_AUDIO_SIZE_MB=10
MAX_URLS_PER_REQUEST=5
MULTIMODAL_QDRANT_COLLECTION=papeer_multimodal_v1
DEBUG=false
